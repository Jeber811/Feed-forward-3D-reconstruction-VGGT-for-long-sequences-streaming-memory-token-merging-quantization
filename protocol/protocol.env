# Shared protocol settings - sourced by protocol/*.sbatch. Change only together with PROTOCOL.md (version + changelog).
PROTOCOL_VERSION=0.4
# Measurement-identical versions: their final-tier results are comparable and tabulated together (v0.4 only added a site).
PROTOCOL_COMPATIBLE="0.3 0.4"
# Repo root = the clone you submit from (each person uses their own clone; results land in it).
REPO=${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
HARNESS=$REPO/tools/eval_scannet_any.py
RESULTS_ROOT=${RESULTS_ROOT:-$REPO/results}
# Shared, read-only inputs on the CRCV cluster (pinned; see THIRD_PARTY.lock).
export THIRD_PARTY=${THIRD_PARTY:-/home/ja396977/cap6411/repos}
export CKPT_DIR=${CKPT_DIR:-/home/ja396977/cap6411/ckpt}
# Site (v0.4): crcv (default) or newton (UCF ARCC, detected by its /lustre/fs1). Only paths and GPU requests differ;
# env, third-party code and checkpoints are byte-identical copies at the same absolute paths.
SITE=${SITE:-$([ -d /lustre/fs1 ] && echo newton || echo crcv)}
if [ "$SITE" = newton ]; then
  DATA=/home/ja396977/cap6411/scannet/process_scannet   # verified copy of the CRCV frames (file count + bytes per scene)
  GT_PLY_DIR=/home/ja396977/cap6411/scannet/scans
  CONDA_SH=/apps/anaconda/anaconda-2024.10/etc/profile.d/conda.sh
  # Newton has glibc 2.28 but the env's open3d 0.20 needs 2.32: overlay open3d 0.18.0 (manylinux_2_27). open3d only
  # reads the GT PLY and computes point distances (metrics); tools/crosscheck_tiers.py verifies identical metrics.
  # Overlay = pip --no-deps --target: open3d==0.18.0 scikit-learn==1.5.2 joblib==1.4.2 threadpoolctl==3.5.0 addict==2.4.0
  export PYTHONPATH=/home/ja396977/cap6411/newton_overlay${PYTHONPATH:+:$PYTHONPATH}
else
  DATA=/home/zhyw86/WorkSpace/cap6411/dataset/scannet/process_scannet
  GT_PLY_DIR=/squash/scannetv2/scans
  CONDA_SH=/share/apps/anaconda3-2022.05/etc/profile.d/conda.sh
fi
CONDA_ENV=/home/ja396977/.conda/envs/cap6411_env   # torch 2.3.1+cu121; read-only for everyone, do not pip install into it
DEV_SCENES="scene0111_00 scene0188_00"
FINAL_SCENE_SET_DIR=$REPO/protocol/scene_sets
# Fixed-N cohorts contain only scenes with at least N distinct usable frames.
# Set SCENES from the matching file when submitting each final run.
FINAL_SCENES_300=$(tr '\n' ' ' < "$FINAL_SCENE_SET_DIR/scannet50_v03_N300.txt")
FINAL_SCENES_500=$(tr '\n' ' ' < "$FINAL_SCENE_SET_DIR/scannet50_v03_N500.txt")
FINAL_SCENES_1000=$(tr '\n' ' ' < "$FINAL_SCENE_SET_DIR/scannet50_v03_N1000.txt")
FINAL_SCENES_2000=$(tr '\n' ' ' < "$FINAL_SCENE_SET_DIR/scannet50_v03_N2000.txt")
# Tier B technique grid (PROTOCOL.md §6 run plan): first 10 cohort IDs, N=500 only.
GRID_SCENES_500=$(tr '\n' ' ' < "$FINAL_SCENE_SET_DIR/scannet50_v03_grid10_N500.txt")
LENGTHS="300 500 1000 2000"
BUDGETS_GB="6 10 16"
export CAP_DTYPE=float16 PYTHONUNBUFFERED=1 CH_MEMORDER=recent_first CH_ALIGN=svd
# GPU request strings for sbatch (final numbers only on the 24 GB Quadro RTX 6000 nodes c3-6/c3-7)
GPU_FINAL="--gres=gpu:turing:1 --constraint=gmem24 --exclude=c2-0,c2-1,c3-2,c3-3,c3-4,c3-5"
SUBMIT_OPTS="--qos=short --requeue"
FINAL_TIER=rtx6000
if [ "$SITE" = newton ]; then
  # v0.4 tier v100_cap24: Tesla V100-PCIE-32GB (fp16, no bf16, no FlashAttention - like the RTX 6000) with PyTorch
  # capped at 24 GB (CAP_MEM_CAP_GB). Accuracy + memory only; timing claims stay on rtx6000 (PROTOCOL.md section 1).
  GPU_FINAL="--account=course_cap5415 --partition=normal --constraint=gpu32 --gres=gpu:1 --exclude=evc11"  # evc11: a V100 not detected (Nov 5)
  SUBMIT_OPTS="--requeue"
  FINAL_TIER=v100_cap24
  export CAP_MEM_CAP_GB=24
  GOLDEN_COMPARE_MEM=1                 # compare peak memory against the RTX 6000 reference (same allocator, same kernels)
  GOLDEN_SKIP="ttt3r_offload"          # CUT3R/TTT3R curope kernel is not built for V100: recurrent models stay on rtx6000
fi
GPU_SMOKE="--gres=gpu:ampere:1 --constraint=gmem48|gmem80 --exclude=c2-1"
# Reference tier for UNBOUNDED controls that run out of memory on 24 GB (VGGT/pi3 at 500-1000 frames): TIER=a100_ref
GPU_REF="--gres=gpu:ampere:1 --constraint=gmem80 --exclude=c2-1"
if [ "$SITE" = newton ]; then GPU_SMOKE=$GPU_FINAL; GPU_REF="NO_REF_TIER_ON_NEWTON"; fi
# Timing runs: add CAP_TIMING_REPEATS=3 to EXTRA_ENV (median of 3 reported); NAME suffix _timing, one scene is enough.
ckpt_for() { case $1 in
  pi3|pi3_chunk|pi3_kfinterp) echo $CKPT_DIR/pi3_model.safetensors ;;
  vggt_star|fastvggt|vggt_chunk|fastvggt_chunk) echo $CKPT_DIR/model_tracker_fixed_e20.pt ;;
  vggt_orig) echo $CKPT_DIR/vggt_1b_model.pt ;;
  streamvggt) echo $CKPT_DIR/streamvggt_checkpoints.pth ;;
  cut3r|cut3r_offload|ttt3r_offload) echo $CKPT_DIR/cut3r_512_dpt_4_64.pth ;;
  spann3r) echo $CKPT_DIR/spann3r_101.pth ;;
  *) echo "UNKNOWN_MODEL_$1" ;;
esac; }
# Inputs stay in host RAM for every method that does not need all frames on the GPU at once.
cpu_inputs_ok() { case $1 in pi3_chunk|vggt_chunk|fastvggt_chunk|pi3_kfinterp|cut3r_offload|ttt3r_offload) return 0 ;; *) return 1 ;; esac; }
# Verify the shared third-party code matches THIRD_PARTY.lock (commit + hash of tracked local changes).
verify_third_party() {
  local bad=0 name commit dsha url
  while read -r name commit dsha url; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    local g="git -c safe.directory=* -C $THIRD_PARTY/$name"
    local c=$($g rev-parse HEAD 2>/dev/null) d=$($g diff 2>/dev/null | sha256sum | cut -c1-64)
    if [[ "$c" != "$commit" || "$d" != "$dsha" ]]; then echo "LOCK MISMATCH: $name commit=$c diff=$d"; bad=1; fi
  done < $REPO/protocol/THIRD_PARTY.lock
  return $bad
}
