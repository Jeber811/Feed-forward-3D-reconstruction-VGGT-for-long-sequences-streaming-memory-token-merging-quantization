# Shared protocol settings - sourced by protocol/*.sbatch. Change only together with PROTOCOL.md (version + changelog).
PROTOCOL_VERSION=0.1
# Repo root = the clone you submit from (each person uses their own clone; results land in it).
REPO=${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
HARNESS=$REPO/tools/eval_scannet_any.py
RESULTS_ROOT=${RESULTS_ROOT:-$REPO/results}
# Shared, read-only inputs on the CRCV cluster (pinned; see THIRD_PARTY.lock).
export THIRD_PARTY=${THIRD_PARTY:-/home/ja396977/cap6411/repos}
export CKPT_DIR=${CKPT_DIR:-/home/ja396977/cap6411/ckpt}
DATA=/home/zhyw86/WorkSpace/cap6411/dataset/scannet/process_scannet
GT_PLY_DIR=/squash/scannetv2/scans
CONDA_SH=/share/apps/anaconda3-2022.05/etc/profile.d/conda.sh
CONDA_ENV=/home/ja396977/.conda/envs/cap6411_env   # torch 2.3.1+cu121; read-only for everyone, do not pip install into it
DEV_SCENES="scene0000_00 scene0013_02"
LENGTHS="300 500 1000 2000"
BUDGETS_GB="6 10 16"
export CAP_DTYPE=float16 PYTHONUNBUFFERED=1 CH_MEMORDER=recent_first CH_ALIGN=svd
# GPU request strings for sbatch (final numbers only on the 24 GB Quadro RTX 6000 nodes c3-6/c3-7)
GPU_FINAL="--gres=gpu:turing:1 --constraint=gmem24 --exclude=c2-0,c2-1,c3-2,c3-3,c3-4,c3-5"
GPU_SMOKE="--gres=gpu:ampere:1 --constraint=gmem48|gmem80 --exclude=c2-1"
ckpt_for() { case $1 in
  pi3|pi3_chunk|pi3_kfinterp) echo $CKPT_DIR/pi3_model.safetensors ;;
  vggt_star|fastvggt|vggt_chunk|fastvggt_chunk) echo $CKPT_DIR/model_tracker_fixed_e20.pt ;;
  vggt_orig) echo $CKPT_DIR/vggt_1b_model.pt ;;
  streamvggt) echo $CKPT_DIR/streamvggt_checkpoints.pth ;;
  cut3r|cut3r_offload|ttt3r_offload) echo $CKPT_DIR/cut3r_512_dpt_4_64.pth ;;
  spann3r) echo $CKPT_DIR/spann3r_101.pth ;;
  *) echo "UNKNOWN_MODEL_$1" ;;
esac; }
# Inputs stay in host RAM for every method that does not need all frames on the GPU at once.
cpu_inputs_ok() { case $1 in pi3_chunk|vggt_chunk|fastvggt_chunk|pi3_kfinterp) return 0 ;; *) return 1 ;; esac; }
# Verify the shared third-party code matches THIRD_PARTY.lock (commit + hash of tracked local changes).
verify_third_party() {
  local bad=0 name commit dsha url
  while read -r name commit dsha url; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    local g="git -c safe.directory=* -C $THIRD_PARTY/$name"
    local c=$($g rev-parse HEAD 2>/dev/null) d=$($g diff 2>/dev/null | sha256sum | cut -c1-64)
    if [[ "$c" != "$commit" || "$d" != "$dsha" ]]; then echo "LOCK MISMATCH: $name commit=$c diff=$d"; bad=1; fi
  done < $REPO/protocol/THIRD_PARTY.lock
  return $bad
}
